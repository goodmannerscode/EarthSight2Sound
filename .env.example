# Copy to .env and fill in. Never commit .env.

# --- Cloudflare R2 (S3-compatible API) ---
# Account ID from the Cloudflare dashboard URL: dash.cloudflare.com/<ACCOUNT_ID>/r2
R2_ACCOUNT_ID=
# R2 API token credentials (R2 > Manage API Tokens > Create API token)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3 endpoint. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL, no trailing slash. Either https://pub-<hash>.r2.dev
# or https://cdn.yourdomain.com if a custom domain is attached.
R2_PUBLIC_BASE_URL=

# --- MariaDB ---
DATABASE_URL=

# --- Server ---
PORT=
NODE_ENV=

# --- Sonification ---
# Absolute path to the image2sound binary, or just "image2sound" if on PATH.
IMAGE2SOUND_BIN=

# --- Frontend (public, safe to expose) ---
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=
